# === Required ===
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
KIMI_API_KEY=sk-...

# === Model overrides (optional) ===
# CLAUDE_MODEL_ID=claude-sonnet-4-6
# DEEPSEEK_MODEL_ID=deepseek-chat
# KIMI_MODEL_ID=moonshot-v1-8k        # options: moonshot-v1-8k | moonshot-v1-32k | moonshot-v1-128k
# OLLAMA_MODEL_ID=llama3

# === Backend ===
# OLLAMA_BASE_URL=http://localhost:11434
# DEFAULT_MODEL=claude                 # claude | deepseek | kimi | ollama

# === Storage ===
# DB_PATH=~/theia-soul/memory/theia.db

# === API Server ===
# API_HOST=0.0.0.0
# API_PORT=8000

# === Logging ===
# LOG_LEVEL=INFO
